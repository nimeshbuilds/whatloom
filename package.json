  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  },
  "type": "module",
  "description": "A local invention studio for exploring possibilities, evidence, and first proofs.",
